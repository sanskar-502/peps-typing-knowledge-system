    <edge source="alt_484_1" target="pep_695" id="0">
      <data key="d17">resembles</data>
      <data key="d19">PEP 484 rejected angle brackets for generics; PEP 695 revisited type parameter syntax and chose a different approach entirely.</data>
    </edge>
    <edge source="alt_563_10" target="pep_649" id="0">
      <data key="d17">resembles</data>
      <data key="d19">PEP 563 rejected lazy/deferred evaluation as too complex; PEP 649 later shipped this exact approach with a different mechanism.</data>
    </edge>
    <edge source="alt_647_24" target="pep_742" id="0">
      <data key="d17">resembles</data>
      <data key="d19">PEP 647 rejected bidirectional narrowing for TypeGuard; PEP 742 introduced TypeIs which provides this with stricter guarantees.</data>
    </edge>
  </graph>
